# Copy this file to `.env` and adjust as needed. All values shown are the
# defaults MiniSense falls back to when a variable is unset, except secrets
# (API_AUTH_TOKEN), which are unset by default.
#
# `.env` is git-ignored — never commit real secrets. In production, prefer
# injecting these as real environment variables (e.g. via your orchestrator's
# secrets manager) over shipping a `.env` file at all.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# One of: development, staging, production. Controls FastAPI docs exposure
# and default log verbosity (see minisense/config.py).
MINISENSE_ENV=development

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
MINISENSE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Ollama (local LLM runtime — required for LLM-quality planning, narrative
# summaries, and embeddings; the system falls back to a deterministic
# heuristic/template path when unreachable, see README "Setup")
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
MINISENSE_LLM_MODEL=llama3.1:8b
MINISENSE_EMBED_MODEL=nomic-embed-text
MINISENSE_LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Data & storage paths (all relative to the repo root by default)
# ---------------------------------------------------------------------------
MINISENSE_SURVEY_PATH=data/survey_responses.json
MINISENSE_FAQ_PATH=data/product_faq.md

# ---------------------------------------------------------------------------
# RAG / chunking
# ---------------------------------------------------------------------------
MINISENSE_CHUNK_MAX_CHARS=500
MINISENSE_CHUNK_OVERLAP_CHARS=80
MINISENSE_TOP_K_DEFAULT=4

# ---------------------------------------------------------------------------
# API surface (minisense.api / FastAPI)
# ---------------------------------------------------------------------------
# Bearer token required on /ask when set. Leave unset only for local dev —
# the app refuses to start with an unset token when MINISENSE_ENV=production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# Comma-separated list of allowed CORS origins. Empty = no cross-origin
# access permitted (same-origin/API-client only), which is the safe default.
API_CORS_ORIGINS=

# Simple in-memory rate limit: max requests per client IP per window.
API_RATE_LIMIT_REQUESTS=30
API_RATE_LIMIT_WINDOW_SECONDS=60

# Longest business question accepted by the API/CLI, in characters. Guards
# against pathological prompts being forwarded to the local LLM.
API_MAX_QUESTION_CHARS=1000
