# Copy to .env and adjust. This gateway proxies to the Python FastAPI
# backend (uvicorn minisense.api:app) so the browser client never needs to
# know the backend's bearer token.

# Port this Node gateway listens on.
PORT=3000

# Base URL of the running MiniSense FastAPI backend.
MINISENSE_API_URL=http://localhost:8000

# Bearer token the FastAPI backend expects (must match API_AUTH_TOKEN in
# the Python project's own .env). Leave blank only if the backend has no
# API_AUTH_TOKEN configured.
MINISENSE_API_TOKEN=

# Requests per IP per window this gateway allows, on top of the backend's
# own rate limit.
GATEWAY_RATE_LIMIT_REQUESTS=30
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
